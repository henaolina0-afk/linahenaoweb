{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Mismo nombre que el Worker ya creado en la cuenta de Lina (conectado a GitHub)
  "name": "linahenaoweb",
  "account_id": "ba3aafa131f3cfcd99a8f7a3ca2b3d96",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  // wrangler deploy construye el sitio antes de publicar (genera ./out)
  "build": { "command": "npm run build" },
  "workers_dev": true,
  // Dominio propio (zona linahenao.net en la cuenta de Lina). www redirige a la raíz con una Redirect Rule de Cloudflare
  "routes": [
    { "pattern": "linahenao.net", "custom_domain": true },
    { "pattern": "www.linahenao.net", "custom_domain": true }
  ],
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    // Solo /api/* pasa por el código del Worker; el resto lo sirve Cloudflare directo
    "run_worker_first": ["/api/*"]
  },
  // Todos los días a las 5:00 a. m. de Colombia (10:00 UTC)
  "triggers": { "crons": ["0 10 * * *"] },
  "observability": { "enabled": true }
}
